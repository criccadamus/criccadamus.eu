{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "criccadamus-eu",
  "main": "./src/server-entry.ts",
  "workers_dev": false,
  "preview_urls": true,
  "compatibility_date": "2025-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "kv_namespaces": [
    {
      "binding": "REGISTRY_KV",
      "id": "ea8f47ddfc484952a02e8b5e6071407d",
    },
  ],
  "observability": {
    "enabled": false,
  },
  "routes": [
    {
      "pattern": "criccadamus.eu",
      "custom_domain": true,
    },
  ],
}
