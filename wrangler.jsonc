{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "criccadamus-eu",
  "main": "./src/server-entry.ts",
  "workers_dev": false,
  "preview_urls": true,
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "REGISTRY_KV",
      "id": "ea8f47ddfc484952a02e8b5e6071407d",
    },
  ],
  "r2_buckets": [
    {
      "binding": "REGISTRY_MEDIA_BUCKET",
      "bucket_name": "criccadamus-eu-registry",
    },
  ],
  "observability": {
    "enabled": false,
  },
  "routes": [
    {
      "pattern": "criccadamus.eu",
      "custom_domain": true,
    },
  ],
}
